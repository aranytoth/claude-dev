<%- include('../partials/public-header') %>

<div class="row">
  <div class="col-md-8 offset-md-2">
    <article>
      <h1 class="mb-3"><%= post.title %></h1>

      <p class="text-muted mb-4">
        <small>
          By <%= post.author_name %>
          on <%= new Date(post.published_at).toLocaleDateString() %>
          <% if (post.category_name) { %>
          in <a href="/category/<%= post.category_name.toLowerCase() %>"><%= post.category_name %></a>
          <% } %>
        </small>
      </p>

      <div class="content">
        <%- post.content %>
      </div>

      <% if (tags.length > 0) { %>
      <div class="mt-4">
        <strong>Tags:</strong>
        <% tags.forEach((tag, index) => { %>
          <a href="/tag/<%= tag.slug %>" class="badge bg-secondary text-decoration-none"><%= tag.name %></a>
        <% }) %>
      </div>
      <% } %>

      <hr class="my-4">
      <a href="/" class="btn btn-outline-primary">&larr; Back to Home</a>
    </article>
  </div>
</div>

<%- include('../partials/public-footer') %>
