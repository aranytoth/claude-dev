<%- include('../partials/public-header') %>

<div class="row">
  <div class="col-md-8 offset-md-2">
    <h1 class="mb-4">Tag: <%= tag.name %></h1>

    <hr>

    <% if (posts.length > 0) { %>
      <% posts.forEach(post => { %>
      <article class="mb-4 pb-4 border-bottom">
        <h2><a href="/post/<%= post.slug %>" class="text-decoration-none"><%= post.title %></a></h2>
        <p class="text-muted">
          <small>
            By <%= post.author_name %>
            on <%= new Date(post.published_at).toLocaleDateString() %>
            <% if (post.category_name) { %>
            in <a href="/category/<%= post.category_name.toLowerCase() %>"><%= post.category_name %></a>
            <% } %>
          </small>
        </p>
        <% if (post.excerpt) { %>
        <p><%= post.excerpt %></p>
        <% } %>
        <a href="/post/<%= post.slug %>" class="btn btn-primary btn-sm">Read More</a>
      </article>
      <% }) %>
    <% } else { %>
      <div class="alert alert-info">
        <p>No posts with this tag yet.</p>
      </div>
    <% } %>

    <a href="/" class="btn btn-outline-primary mt-3">&larr; Back to Home</a>
  </div>
</div>

<%- include('../partials/public-footer') %>
