<%- include('../partials/public-header') %>

<div class="row">
  <div class="col-md-8">
    <h1 class="mb-4">Latest Posts</h1>

    <% if (posts.length > 0) { %>
      <% posts.forEach(post => { %>
      <article class="mb-4 pb-4 border-bottom">
        <h2><a href="/post/<%= post.slug %>" class="text-decoration-none"><%= post.title %></a></h2>
        <p class="text-muted">
          <small>
            By <%= post.author_name %>
            on <%= new Date(post.published_at).toLocaleDateString() %>
            <% if (post.category_name) { %>
            in <a href="/category/<%= post.slug %>"><%= post.category_name %></a>
            <% } %>
          </small>
        </p>
        <% if (post.excerpt) { %>
        <p><%= post.excerpt %></p>
        <% } %>
        <a href="/post/<%= post.slug %>" class="btn btn-primary btn-sm">Read More</a>
      </article>
      <% }) %>
    <% } else { %>
      <div class="alert alert-info">
        <p>No posts published yet. Check back soon!</p>
      </div>
    <% } %>
  </div>

  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header">
        <h5>Categories</h5>
      </div>
      <div class="card-body">
        <% if (categories.length > 0) { %>
        <ul class="list-unstyled">
          <% categories.forEach(category => { %>
          <li><a href="/category/<%= category.slug %>"><%= category.name %></a></li>
          <% }) %>
        </ul>
        <% } else { %>
        <p class="text-muted small">No categories yet</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/public-footer') %>
