<%- include('../../partials/admin-header') %>

<div class="row mt-4">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>All Posts</h2>
      <a href="/admin/posts/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Post</a>
    </div>

    <div class="card">
      <div class="card-body">
        <% if (posts.length > 0) { %>
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Title</th>
              <th>Author</th>
              <th>Category</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
            <tr>
              <td><strong><%= post.title %></strong></td>
              <td><%= post.author_name %></td>
              <td><%= post.category_name || 'Uncategorized' %></td>
              <td>
                <% if (post.status === 'published') { %>
                <span class="badge bg-success">Published</span>
                <% } else { %>
                <span class="badge bg-secondary">Draft</span>
                <% } %>
              </td>
              <td><%= new Date(post.created_at).toLocaleDateString() %></td>
              <td>
                <a href="/admin/posts/<%= post.id %>/edit" class="btn btn-sm btn-primary">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form method="POST" action="/admin/posts/<%= post.id %>?_method=DELETE" style="display: inline;">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
                <% if (post.status === 'published') { %>
                <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-sm btn-info">
                  <i class="bi bi-eye"></i> View
                </a>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <p class="text-muted">No posts found. <a href="/admin/posts/new">Create your first post</a></p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>
