<%- include('../../partials/admin-header') %>

<div class="row mt-4">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Tags</h2>
      <a href="/admin/tags/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Tag</a>
    </div>

    <div class="card">
      <div class="card-body">
        <% if (tags.length > 0) { %>
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Slug</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tags.forEach(tag => { %>
            <tr>
              <td><strong><%= tag.name %></strong></td>
              <td><code><%= tag.slug %></code></td>
              <td>
                <a href="/admin/tags/<%= tag.id %>/edit" class="btn btn-sm btn-primary">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form method="POST" action="/admin/tags/<%= tag.id %>?_method=DELETE" style="display: inline;">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <p class="text-muted">No tags found. <a href="/admin/tags/new">Create one</a></p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>
